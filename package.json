{
  "scripts": {
    "dev": "tsx watch -r tsconfig-paths/register src/server.ts",
    "build": "tsc && tsc-alias --resolve-full-paths --resolve-full-extension .js",
    "start": "node dist/server.js",
    "migrate": "bunx drizzle-kit generate && bunx drizzle-kit migrate && bun casbin",
    "setting": "bun run src/scripts/cli.ts",
    "settingDb": "bun run src/scripts/initDatabase.ts",
    "casbin": "bun run src/scripts/casbi_rules.ts"
  },
  "dependencies": {
    "@getbrevo/brevo": "^6.0.2",
    "@inquirer/prompts": "^8.5.2",
    "@neondatabase/serverless": "^1.1.0",
    "@types/jsonwebtoken": "^9.0.10",
    "argon2": "^0.45.1",
    "casbin": "^5.51.1",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.21",
    "dotenv": "^17.4.2",
    "drizzle-adapter": "^1.4.0",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "joi": "^18.2.3",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "mysql2": "^3.22.5",
    "otpauth": "^9.5.1",
    "pg": "^8.21.0",
    "postgres": "^3.4.9",
    "rfc4648": "^1.5.4",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.9.3",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.17",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
